          "request": {
            "name": "GamerPower List Giveaways",
            "description": {
              "content": "Returns all currently live giveaways. Supports optional filtering by `platform`\nand `type` (single-value here; use `/filter` for multi-value), and sorting via\n`sort-by`.\n",
