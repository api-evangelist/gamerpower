                  "value": "<string>",
                  "description": "Filter giveaways by single platform."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter giveaways by giveaway type."
                },
                {
                  "disabled": false,
                  "key": "sort-by",
                  "value": "<string>",
                  "description": "Sort the returned giveaways."
