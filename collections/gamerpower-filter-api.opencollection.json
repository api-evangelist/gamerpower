{
  "opencollection": "1.0.0",
  "info": {
    "name": "GamerPower Filter API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Filter",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GamerPower Filter Giveaways By Multiple Values",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.gamerpower.com/api/filter",
            "params": [
              {
                "name": "platform",
                "value": "epic-games-store.steam",
                "type": "query",
                "description": "Dot-separated list of platforms (e.g. `epic-games-store.steam`)."
              },
              {
                "name": "type",
                "value": "game.loot",
                "type": "query",
                "description": "Dot-separated list of giveaway types (e.g. `game.loot`)."
              },
              {
                "name": "sort-by",
                "value": "date",
                "type": "query",
                "description": "Sort the returned giveaways."
              }
            ]
          },
          "docs": "Returns live giveaways filtered by one or more platforms and one or more\ngiveaway types. Multiple values are dot-separated (e.g. `platform=epic-games-store.steam`\nand `type=game.loot`).\n"
        }
      ]
    }
  ],
  "bundled": true
}